[
  {
    "id": "observability-architecture",
    "kind": "architecture",
    "title": "testrepo diagnostic utility architecture",
    "subtitle": "Current implemented composition",
    "repository": "mmurugayen/testrepo",
    "source_commit": "89795c0961a9feb3fa4e4a2c63018b39fa1a86da",
    "description": "testrepo diagnostic utility architecture. Nested cards identify components within process, storage, source and external boundaries. Lines denote structural associations, not action order.",
    "units": [
      {
        "id": "host",
        "col": 0,
        "row": 0,
        "title": "MCP host",
        "boundary": "operator-selected client",
        "type": "client",
        "components": [
          "JSON-RPC over stdin / stdout",
          "Protected configuration and credentials"
        ]
      },
      {
        "id": "mcp",
        "col": 1,
        "row": 0,
        "title": "Diagnostic subprocess",
        "boundary": "local Python process",
        "type": "process",
        "components": [
          "ObservabilityMCP: stdio / backend dispatch",
          "LogReader: bounded fixed-source reads",
          "Diagnostic contract: sanitize / correlate"
        ]
      },
      {
        "id": "logs",
        "col": 2,
        "row": 0,
        "title": "Protected JSONL logs",
        "boundary": "local read-only evidence",
        "type": "files",
        "components": [
          "Fixed operator-configured source files",
          "Sanitized bounded events and correlation"
        ]
      },
      {
        "id": "backend",
        "col": 1,
        "row": 1,
        "title": "Compatible HPC backend",
        "boundary": "optional external deployment",
        "type": "external",
        "components": [
          "Diagnostic API and registered plans",
          "Independent approval; allowlisted handlers",
          "PostgreSQL resolution memory; migration 017"
        ]
      }
    ],
    "edges": [
      {
        "from": "host",
        "to": "mcp",
        "label": "stdio",
        "dependency": false
      },
      {
        "from": "mcp",
        "to": "logs",
        "label": "read-only",
        "dependency": false
      },
      {
        "from": "mcp",
        "to": "backend",
        "label": "HTTPS",
        "dependency": false
      }
    ],
    "scope": "This repository owns a diagnostic utility. The optional backend has its own installation, credentials and execution authority."
  },
  {
    "id": "observability-workflow",
    "kind": "workflow",
    "title": "Utility diagnostic recovery workflow",
    "subtitle": "Current source; independent approval and qualification boundaries remain",
    "nodes": [
      {
        "id": "s0",
        "col": 0,
        "row": 0,
        "title": "Investigate correlated failure evidence",
        "detail": [
          "Use configured logs and validate the cause against current system evidence."
        ]
      },
      {
        "id": "s1",
        "col": 0,
        "row": 1,
        "title": "Consult verified resolution memory",
        "detail": [
          "An enabled registered recommendation requires qualifying distinct verified plans."
        ]
      },
      {
        "id": "s2",
        "col": 0,
        "row": 2,
        "title": "Create a governed plan",
        "detail": [
          "Use only the configured target alias and allowlisted action."
        ]
      },
      {
        "id": "s3",
        "col": 0,
        "row": 3,
        "title": "Obtain separate HPC approval",
        "detail": [
          "The existing backend owns approval; the MCP adapter cannot approve itself."
        ]
      },
      {
        "id": "s4",
        "col": 0,
        "row": 4,
        "title": "Apply the already approved plan once",
        "detail": [
          "Existing HPC state and handler controls determine whether execution is allowed."
        ]
      },
      {
        "id": "s5",
        "col": 0,
        "row": 5,
        "title": "Verify and record the resolution",
        "detail": [
          "Backend checks verified non-simulated outcomes; operator confirms the failure association."
        ]
      },
      {
        "id": "b0",
        "col": 1,
        "row": 1,
        "title": "No recommendation",
        "detail": [
          "Unknown or conflicting evidence does not create a plan."
        ],
        "warning": true
      },
      {
        "id": "b1",
        "col": 1,
        "row": 4,
        "title": "Reconcile outcome",
        "detail": [
          "No automatic effect retry after an uncertain response."
        ],
        "warning": true
      },
      {
        "id": "local",
        "col": 1,
        "row": 0,
        "title": "Local investigation",
        "detail": [
          "No backend: return log findings only."
        ],
        "warning": false
      }
    ],
    "edges": [
      {
        "from": "s0",
        "to": "s1",
        "label": ""
      },
      {
        "from": "s1",
        "to": "s2",
        "label": ""
      },
      {
        "from": "s2",
        "to": "s3",
        "label": ""
      },
      {
        "from": "s3",
        "to": "s4",
        "label": ""
      },
      {
        "from": "s4",
        "to": "s5",
        "label": ""
      },
      {
        "from": "s1",
        "to": "b0",
        "label": "unqualified"
      },
      {
        "from": "s4",
        "to": "b1",
        "label": "uncertain"
      },
      {
        "from": "s0",
        "to": "local",
        "label": "no backend"
      }
    ],
    "description": "Platform diagnostic recovery workflow with explicit alternative outcomes.",
    "source_commit": "89795c0961a9feb3fa4e4a2c63018b39fa1a86da",
    "repository": "mmurugayen/testrepo"
  }
]
